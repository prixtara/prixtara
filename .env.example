# ==============================================================================
# PRIXTARA — Environment Variables
# ==============================================================================
#
# HOW TO USE:
#   Copy this file to .env.local for local development:
#     cp .env.example .env.local
#
# CRITICAL SECURITY RULE:
#   Variables prefixed with NEXT_PUBLIC_ are bundled into the client-side
#   JavaScript and are visible to ALL users in the browser. NEVER put secrets,
#   API tokens, or credentials in a NEXT_PUBLIC_ variable.
#
# VARIABLE NAMING CONVENTION:
#   NEXT_PUBLIC_*   → Safe for browser. Visible to anyone.
#   (no prefix)     → Server-only. NEVER sent to the browser bundle.
#
# ENVIRONMENTS:
#   .env.local        → Local development (never commit)
#   .env.development  → Development overrides
#   .env.preview      → Preview/staging environment
#   .env.production   → Production environment
#
# See packages/validation/src/env.ts for the Zod schema that validates
# all environment variables at startup.
# ==============================================================================


# ------------------------------------------------------------------------------
# [SERVER-ONLY] Sanity CMS
# These variables MUST NOT be prefixed with NEXT_PUBLIC_.
# They are used server-side only for authenticated CMS queries.
# ------------------------------------------------------------------------------

# Sanity read/write API token. Generate at: https://sanity.io/manage
SANITY_API_TOKEN=

# Secret used to verify Sanity webhook signatures (on-demand ISR / revalidation).
# Generate a random string: openssl rand -hex 32
SANITY_WEBHOOK_SECRET=


# ------------------------------------------------------------------------------
# [SERVER-ONLY] Error Monitoring — Sentry
# TODO(monitoring): Create a Sentry project and populate these values.
# See docs/architecture.md for observability strategy.
# ------------------------------------------------------------------------------

# Server-side Sentry DSN (Data Source Name)
SENTRY_DSN=

# Sentry auth token for source-map uploads during CI build
SENTRY_AUTH_TOKEN=

# Sentry organisation slug (from Sentry settings)
SENTRY_ORG=

# Sentry project slug
SENTRY_PROJECT=


# ------------------------------------------------------------------------------
# [SERVER-ONLY] Application Secrets
# TODO(forms): Add form-handling credentials when form service is selected.
# TODO(careers): Add job-application storage credentials.
# ------------------------------------------------------------------------------


# ------------------------------------------------------------------------------
# [PUBLIC] Sanity CMS — Safe for browser
# Required to build the Sanity client used in client components.
# ------------------------------------------------------------------------------

# Sanity project ID (visible in your Sanity dashboard)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset name (e.g. "production" or "staging")
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version (ISO date string — pin to a stable date)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01


# ------------------------------------------------------------------------------
# [PUBLIC] Site
# ------------------------------------------------------------------------------

# Canonical site URL. No trailing slash.
# Used for: sitemap generation, OG image absolute URLs, canonical tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# [PUBLIC] Analytics
# TODO(analytics): Populate once analytics provider is selected.
# See packages/analytics/src/index.ts for the integration point.
# ------------------------------------------------------------------------------

# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Client-side Sentry DSN (can be same as server DSN — it is public by design)
NEXT_PUBLIC_SENTRY_DSN=


# ------------------------------------------------------------------------------
# [PUBLIC] Feature Flags
# TODO: Add feature flags when flag management is implemented.
# ------------------------------------------------------------------------------
