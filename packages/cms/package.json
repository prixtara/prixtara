{
  "name": "@prixtara/cms",
  "version": "0.0.1",
  "private": true,
  "description": "Sanity CMS access layer — all CMS queries, schemas, client, adapters, and type-generation",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
